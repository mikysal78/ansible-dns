# .ansible-lint
---
profile: production

exclude_paths:
  - .github/
  - molecule/
  - .cache/
  - .git/

# Regole rilassate con motivazione:
skip_list:
  # Le variabili DNS sono condivise tra più role (bind9_primary, bind9_secondary,
  # dnssec, monitoring, acme_dns) tramite group_vars/all. Il prefisso per-role
  # romperebbe la condivisione, quindi usiamo nomi globali coerenti (bind_, dns_, ddns_).
  - var-naming[no-role-prefix]
  # Gli handler usano la convenzione lowercase tradizionale ("restart bind9")
  # che è ampiamente adottata e referenziata nei notify.
  - name[casing]

warn_list:
  - yaml[line-length]
  - ignore-errors           # usato consapevolmente per pacchetti opzionali su Trixie
  - risky-file-permissions  # alcuni file di log ereditano i permessi corretti dal sistema
  - command-instead-of-module
  - risky-shell-pipe
  - no-handler
  - inline-env-var

use_default_rules: true

# NB: NESSUN mock_modules. Tutti i moduli usati provengono da collection
# installate da requirements.yml (community.general, community.proxmox,
# ansible.posix), quindi ansible-lint li risolve dai moduli reali. Aggiungere
# un mock per un modulo GIA' installato crea un conflitto stub/collezione reale
# (mock in .ansible/ansible-lint-mocks vs collezione reale) che, con le versioni
# recenti di ansible-lint, fa fallire la risoluzione → syntax-check exit 2.

verbosity: 1
